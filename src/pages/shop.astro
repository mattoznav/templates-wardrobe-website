---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import ProductCard from "../components/ProductCard.astro";
import { DEPARTMENTS, catalog, sectionOf } from "../lib/catalog";
import { withBase } from "../lib/paths";

const { store, products, categories, colours, sizes } = await catalog();

// Only offer filters that match something
const usedColours = colours.filter((c) => products.some((p) => p.colours.some((pc) => pc.slug === c.slug)));
const usedSizes = sizes.filter((s) => products.some((p) => p.sizes.some((ps) => ps.code === s.code)));
const categoriesBySection = Object.fromEntries(
  ["all", ...DEPARTMENTS.map((d) => d.slug)].map((section) => [
    section,
    categories.filter((c) => products.some((p) => p.category === c.slug && (section === "all" || sectionOf(p) === section || (section !== "accessories" && p.department === "unisex" && sectionOf(p) !== "accessories")))).map((c) => c.slug),
  ]),
);
---

<Base title="Shop" description="Women, men and accessories in natural fibres.">
  <section class="shop" data-shop data-categories={JSON.stringify(categoriesBySection)}>
    <div class="wrap">
      <header class="shop__head">
        <span class="eyebrow" data-shop-eyebrow>The collection</span>
        <h1 data-shop-title>Shop all</h1>
      </header>

      <nav class="tabs" aria-label="Section">
        <a href={withBase("/shop/")} data-section-tab="">All</a>
        {DEPARTMENTS.map((d) => <a href={withBase(`/shop/?section=${d.slug}`)} data-section-tab={d.slug}>{d.name}</a>)}
      </nav>

      <div class="bar">
        <div class="chips" role="group" aria-label="Category">
          <button type="button" class="chip" data-category="" aria-pressed="true">Everything</button>
          {categories.map((c) => <button type="button" class="chip" data-category={c.slug} aria-pressed="false">{c.name}</button>)}
        </div>
        <div class="bar__tools">
          <button type="button" class="bar__filter" data-filter-toggle aria-expanded="false" aria-controls="filters">
            <Icon name="sliders-horizontal" size={18} /> Filter <span data-filter-count></span>
          </button>
          <label class="bar__sort">
            <span class="visually-hidden">Sort by</span>
            <select data-sort>
              <option value="featured">Featured</option>
              <option value="newest">Newest</option>
              <option value="price_asc">Price, low to high</option>
              <option value="price_desc">Price, high to low</option>
            </select>
          </label>
        </div>
      </div>

      <div class="filters" id="filters" data-filters hidden>
        <fieldset>
          <legend class="eyebrow">Colour</legend>
          <div class="swatches">
            {
              usedColours.map((c) => (
                <label class="swatch" title={c.name}>
                  <input type="checkbox" name="colour" value={c.slug} />
                  <span class="swatch__dot" style={`--swatch: ${c.hex}`} />
                  <span>{c.name}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <fieldset>
          <legend class="eyebrow">Size in stock</legend>
          <div class="sizes">
            {
              usedSizes.map((s) => (
                <label class="size">
                  <input type="checkbox" name="size" value={s.code} />
                  <span>{s.label}</span>
                </label>
              ))
            }
          </div>
        </fieldset>
        <fieldset>
          <legend class="eyebrow">Show</legend>
          <label class="check"><input type="checkbox" name="new" value="1" /> New in</label>
          <label class="check"><input type="checkbox" name="sale" value="1" /> On sale</label>
          <button type="button" class="text-link" data-clear>Clear all filters</button>
        </fieldset>
      </div>

      <p class="count muted" data-count aria-live="polite"></p>

      <div class="grid" data-grid>
        {products.map((p, i) => <ProductCard product={p} currency={store.currency} eager={i < 4} />)}
      </div>

      <div class="empty" data-empty hidden>
        <p>Nothing matches these filters.</p>
        <button type="button" class="link" data-clear>Clear all filters</button>
      </div>
    </div>
  </section>
</Base>

<style>
  .shop {
    padding-block: clamp(32px, 5vw, 64px);
  }

  .shop__head {
    display: grid;
    gap: 12px;
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .tabs {
    display: flex;
    gap: 28px;
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
  }

  .tabs a {
    padding: 12px 0;
    margin-bottom: -1px;
    border-bottom: 1px solid transparent;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
    white-space: nowrap;
  }

  .tabs a[aria-current="page"] {
    color: var(--ink);
    border-color: var(--ink);
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding-block: 18px;
    border-bottom: 1px solid var(--line);
  }

  .chips {
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .chip {
    flex: 0 0 auto;
    padding: 8px 14px;
    border: 1px solid var(--line-strong);
    background: transparent;
    font-size: 13px;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s;
  }

  .chip:hover {
    border-color: var(--ink);
  }

  .chip[aria-pressed="true"] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .bar__tools {
    display: flex;
    gap: 12px;
    flex: 0 0 auto;
  }

  .bar__filter,
  .bar__sort select {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    padding: 0 14px;
    border: 1px solid var(--line-strong);
    border-radius: 0;
    background: transparent;
    font-size: 13px;
    cursor: pointer;
  }

  .bar__filter[aria-expanded="true"] {
    border-color: var(--ink);
  }

  .filters {
    display: grid;
    grid-template-columns: 2fr 1.4fr 1fr;
    gap: 40px;
    padding: 28px 0;
    border-bottom: 1px solid var(--line);
    animation: drop 0.4s var(--ease);
  }

  fieldset {
    display: grid;
    align-content: start;
    gap: 12px;
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    margin-bottom: 12px;
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 8px 16px;
  }

  .swatch,
  .check {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13.5px;
    cursor: pointer;
  }

  .swatch input,
  .size input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .swatch__dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--swatch);
    box-shadow:
      inset 0 0 0 1px rgb(0 0 0 / 0.12),
      0 0 0 3px var(--paper),
      0 0 0 3px transparent;
    transition: box-shadow 0.2s;
  }

  .swatch input:checked + .swatch__dot {
    box-shadow:
      inset 0 0 0 1px rgb(0 0 0 / 0.12),
      0 0 0 3px var(--paper),
      0 0 0 4px var(--ink);
  }

  .swatch input:focus-visible + .swatch__dot,
  .size input:focus-visible + span {
    outline: 1px solid var(--ink);
    outline-offset: 4px;
  }

  .sizes {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .size span {
    display: grid;
    place-items: center;
    min-width: 44px;
    height: 36px;
    padding: 0 8px;
    border: 1px solid var(--line-strong);
    font-size: 12.5px;
    cursor: pointer;
  }

  .size input:checked + span {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .check input {
    accent-color: var(--ink);
    width: 16px;
    height: 16px;
  }

  .count {
    padding-block: 20px;
    font-size: 13px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(32px, 4vw, 56px) clamp(12px, 1.6vw, 24px);
  }

  .empty {
    display: grid;
    justify-items: start;
    gap: 20px;
    padding-block: 64px;
    font-family: var(--display);
    font-size: 28px;
  }

  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
  }

  @media (max-width: 960px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .bar {
      flex-direction: column;
      align-items: stretch;
    }

    .filters {
      grid-template-columns: 1fr;
      gap: 28px;
    }
  }
</style>

<script>
  import { initShop } from "../scripts/shop";
  initShop();
</script>
