---
/**
 * Slide-in bag, opened by the header bag button and after "Add to bag".
 * Rendered by scripts/bag-ui.ts from the bag kept in the browser.
 */
import Icon from "./Icon.astro";
import type { Store } from "../lib/types";

interface Props {
  store: Store;
}
const { store } = Astro.props;
---

<div class="drawer" data-drawer hidden>
  <div class="drawer__scrim" data-drawer-close></div>
  <aside class="drawer__panel" role="dialog" aria-modal="true" aria-labelledby="drawer-title" tabindex="-1" data-drawer-panel>
    <header class="drawer__head">
      <h2 id="drawer-title">Your bag <span class="drawer__count" data-drawer-count></span></h2>
      <button class="drawer__close" type="button" aria-label="Close" data-drawer-close>
        <Icon name="x" size={22} />
      </button>
    </header>

    <p class="drawer__added" data-drawer-added hidden><Icon name="check" size={16} /> <span>Added to your bag</span></p>

    <div class="drawer__body">
      <ul class="drawer__lines" data-drawer-lines></ul>
      <div class="drawer__empty" data-drawer-empty>
        <p>Your bag is empty.</p>
        <a class="link" href="/shop/">Discover the collection</a>
      </div>
    </div>

    <footer class="drawer__foot" data-drawer-foot>
      <div
        class="drawer__free"
        data-free-shipping={store.free_shipping_over ?? ""}
        data-currency={store.currency}
      >
        <p data-free-text></p>
        <div class="drawer__bar"><span data-free-bar></span></div>
      </div>
      <div class="drawer__total">
        <span>Subtotal</span>
        <span class="price" data-drawer-subtotal></span>
      </div>
      <p class="muted drawer__small">Shipping and final prices are confirmed at checkout.</p>
      <a class="btn btn--solid btn--block" href="/checkout/">Checkout</a>
      <a class="btn btn--block" href="/bag/">View bag</a>
    </footer>
  </aside>
</div>

<style>
  .drawer {
    position: fixed;
    inset: 0;
    z-index: var(--z-drawer);
  }

  .drawer__scrim {
    position: absolute;
    inset: 0;
    background: rgb(29 27 24 / 0.32);
    animation: fade 0.35s var(--ease);
  }

  .drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    width: min(440px, 100%);
    background: var(--paper);
    box-shadow: -24px 0 60px rgb(29 27 24 / 0.12);
    animation: slide 0.45s var(--ease);
  }

  .drawer__panel:focus {
    outline: none;
  }

  .drawer__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 22px 24px;
    border-bottom: 1px solid var(--line);
  }

  .drawer__head h2 {
    font-size: 30px;
  }

  .drawer__count {
    font-family: var(--sans);
    font-size: 13px;
    color: var(--muted);
    letter-spacing: 0;
  }

  .drawer__close {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-right: -10px;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .drawer__added {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 24px;
    background: var(--success-soft);
    color: var(--success);
    font-size: 13px;
  }

  .drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: 8px 24px;
  }

  .drawer__lines {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .drawer__empty {
    display: grid;
    justify-items: start;
    gap: 18px;
    padding-top: 32px;
    font-family: var(--display);
    font-size: 24px;
  }

  .drawer__foot {
    display: grid;
    gap: 10px;
    padding: 20px 24px 24px;
    border-top: 1px solid var(--line);
  }

  .drawer__free p {
    font-size: 13px;
    color: var(--ink-soft);
  }

  .drawer__bar {
    height: 2px;
    margin: 8px 0 6px;
    background: var(--line);
  }

  .drawer__bar span {
    display: block;
    height: 100%;
    background: var(--ink);
    transition: width 0.6s var(--ease);
  }

  .drawer__total {
    display: flex;
    justify-content: space-between;
    font-size: 16px;
    font-weight: 500;
  }

  .drawer__small {
    margin-bottom: 6px;
    font-size: 12.5px;
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  @keyframes slide {
    from {
      transform: translateX(100%);
    }
  }
</style>
