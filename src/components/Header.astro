---
import Icon from "./Icon.astro";
import { money } from "../lib/format";
import type { Store } from "../lib/types";
import { withBase } from "../lib/paths";

interface Props {
  store: Store;
}
const { store } = Astro.props;
const path = Astro.url.pathname;
const section = Astro.url.searchParams.get("section");
const left = [
  { href: "/shop/?section=women", label: "Women", key: "women" },
  { href: "/shop/?section=men", label: "Men", key: "men" },
  { href: "/shop/?section=accessories", label: "Accessories", key: "accessories" },
  { href: "/collections/", label: "Collections", key: "collections" },
];
const right = [
  { href: "/about/", label: "Atelier" },
  { href: "/store/", label: "Store" },
];
---

<div class="announce">
  <p>
    {store.free_shipping_over && <span>Free delivery over {money(store.free_shipping_over, store.currency)}</span>}
    <span aria-hidden="true">·</span>
    <span>Returns within {store.return_window_days} days</span>
    <span aria-hidden="true" class="announce__wide">·</span>
    <span class="announce__wide">Hemming in store while you wait</span>
  </p>
</div>

<header class="header" data-header>
  <div class="wrap header__inner">
    <button class="header__menu" type="button" aria-label="Menu" aria-expanded="false" aria-controls="mobile-nav" data-menu-toggle>
      <Icon name="list" size={22} />
    </button>

    <nav class="header__nav" aria-label="Shop">
      {
        left.map((l) => (
          <a href={withBase(l.href)} aria-current={path.startsWith(withBase("/collections")) && l.key === "collections" ? "page" : section === l.key ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <a href={withBase("/")} class="header__logo" aria-label={`${store.name}, home`}>{store.name}</a>

    <div class="header__tools">
      {
        right.map((l) => (
          <a href={withBase(l.href)} class="header__text" aria-current={path.startsWith(withBase(l.href)) ? "page" : undefined}>
            {l.label}
          </a>
        ))
      }
      <a href={withBase("/account/")} class="header__icon" aria-label="Account" title="Account" data-account-link>
        <Icon name="user" size={21} />
      </a>
      <a href={withBase("/bag/")} class="header__bag" data-bag-open aria-label="Bag">
        <Icon name="bag-simple" size={21} />
        <span class="header__count" data-bag-count>0</span>
      </a>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Menu" data-mobile-nav hidden>
    <div class="wrap">
      {[...left, ...right, { href: "/account/", label: "Account" }].map((l) => <a href={withBase(l.href)}>{l.label}</a>)}
    </div>
  </nav>
</header>

<style>
  .announce {
    background: var(--ink);
    color: var(--paper);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-align: center;
  }

  .announce p {
    display: flex;
    justify-content: center;
    gap: 14px;
    padding: 9px 16px;
  }

  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: rgb(246 242 235 / 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--header-h);
  }

  .header__nav,
  .header__tools {
    display: flex;
    align-items: center;
    gap: clamp(16px, 2vw, 30px);
  }

  .header__tools {
    justify-content: flex-end;
  }

  .header__nav a,
  .header__text {
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-soft);
    padding-block: 6px;
    border-bottom: 1px solid transparent;
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .header__nav a:hover,
  .header__text:hover,
  .header__nav a[aria-current="page"],
  .header__text[aria-current="page"] {
    color: var(--ink);
    border-color: var(--ink);
  }

  .header__logo {
    font-family: var(--display);
    font-size: 30px;
    font-weight: 400;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    text-decoration: none;
    padding-left: 0.32em;
  }

  .header__icon,
  .header__bag,
  .header__menu {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    background: none;
    color: var(--ink);
    cursor: pointer;
  }

  .header__count {
    position: absolute;
    top: 3px;
    right: -3px;
    min-width: 17px;
    height: 17px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--paper);
    font-size: 10px;
    font-weight: 600;
    line-height: 17px;
    text-align: center;
    transition: transform 0.3s var(--ease);
  }

  .header__count[data-empty] {
    display: none;
  }

  .header__count.is-bump {
    transform: scale(1.35);
  }

  .header__menu {
    display: none;
  }

  .mobile-nav {
    border-top: 1px solid var(--line);
    background: var(--paper);
  }

  .mobile-nav .wrap {
    display: grid;
    padding-block: 12px 24px;
  }

  .mobile-nav a {
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--display);
    font-size: 28px;
    text-decoration: none;
  }

  @media (max-width: 960px) {
    .header__nav,
    .header__text,
    .announce__wide {
      display: none;
    }

    .header__menu {
      display: inline-grid;
      justify-self: start;
      margin-left: -8px;
    }

    .header__logo {
      font-size: 24px;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]")!;
  const nav = document.querySelector<HTMLElement>("[data-mobile-nav]")!;
  toggle.addEventListener("click", () => {
    const open = nav.hidden;
    nav.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>
